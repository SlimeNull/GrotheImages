<Window x:Class="GrotheImagesPlayground.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:GrotheImagesPlayground"
        Title="GrotheImages Playground" Width="1100" Height="760">
    <DockPanel Margin="8">
        <StatusBar DockPanel.Dock="Bottom"><TextBlock x:Name="StatusText" Text="No GrotheImage is open." /></StatusBar>
        <TabControl>
            <TabItem Header="New">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="8">
                    <GroupBox Header="Logical-size layout" Margin="0,0,0,8"><Grid Margin="8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="120"/><ColumnDefinition Width="150"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                        <TextBlock Text="Width"/><TextBox x:Name="NewWidth" Grid.Column="1" Text="1024"/>
                        <TextBlock Text="Height" Grid.Column="2"/><TextBox x:Name="NewHeight" Grid.Column="3" Text="1024"/>
                        <TextBlock Text="Max tile width" Grid.Row="1"/><TextBox x:Name="NewMaxTileWidth" Grid.Row="1" Grid.Column="1" Text="512"/>
                        <TextBlock Text="Max tile height" Grid.Row="1" Grid.Column="2"/><TextBox x:Name="NewMaxTileHeight" Grid.Row="1" Grid.Column="3" Text="512"/>
                        <TextBlock Text="Overlap X" Grid.Row="2"/><TextBox x:Name="NewOverlapX" Grid.Row="2" Grid.Column="1" Text="0"/>
                        <TextBlock Text="Overlap Y" Grid.Row="2" Grid.Column="2"/><TextBox x:Name="NewOverlapY" Grid.Row="2" Grid.Column="3" Text="0"/>
                        <TextBlock Text="Format" Grid.Row="3"/><ComboBox x:Name="NewFormat" Grid.Row="3" Grid.Column="1"/>
                        <TextBlock Text="Layer names" Grid.Row="3" Grid.Column="2"/><TextBox x:Name="NewLayers" Grid.Row="3" Grid.Column="3" Text="a,b"/>
                        <Button Content="Create logical layout" Grid.Row="4" Grid.ColumnSpan="4" Click="CreateLogicalClick"/>
                    </Grid></GroupBox>
                    <GroupBox Header="Explicit equal-size tile layout"><Grid Margin="8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="120"/><ColumnDefinition Width="150"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                        <TextBlock Text="Tile width"/><TextBox x:Name="TileWidth" Grid.Column="1" Text="512"/>
                        <TextBlock Text="Tile height" Grid.Column="2"/><TextBox x:Name="TileHeight" Grid.Column="3" Text="512"/>
                        <TextBlock Text="Tile rows" Grid.Row="1"/><TextBox x:Name="TileRows" Grid.Row="1" Grid.Column="1" Text="2"/>
                        <TextBlock Text="Tile columns" Grid.Row="1" Grid.Column="2"/><TextBox x:Name="TileColumns" Grid.Row="1" Grid.Column="3" Text="2"/>
                        <TextBlock Text="Overlap X" Grid.Row="2"/><TextBox x:Name="TileOverlapX" Grid.Row="2" Grid.Column="1" Text="0"/>
                        <TextBlock Text="Overlap Y" Grid.Row="2" Grid.Column="2"/><TextBox x:Name="TileOverlapY" Grid.Row="2" Grid.Column="3" Text="0"/>
                        <Button Content="Create explicit layout" Grid.Row="3" Grid.ColumnSpan="4" Click="CreateExplicitClick"/>
                    </Grid></GroupBox>
                </StackPanel></ScrollViewer>
            </TabItem>
            <TabItem Header="Update">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="8">
                    <TextBlock Text="Input file"/><DockPanel><TextBox x:Name="UpdateFile"/><Button Content="Browse" DockPanel.Dock="Right" Width="90" Click="BrowseUpdateClick"/></DockPanel>
                    <WrapPanel Margin="0,6"><TextBlock Text="Layer" VerticalAlignment="Center"/><TextBox x:Name="UpdateLayer" Width="55" Text="0" Margin="5,0,15,0"/><TextBlock Text="Detected" VerticalAlignment="Center"/><TextBlock x:Name="UpdateFileInfo" Text="Choose an image file." Margin="5,0,0,0" VerticalAlignment="Center"/></WrapPanel>
                    <TextBlock Text="Drag the four red points to define the destination quadrilateral. Coordinates are in the target image." Margin="0,8,0,4"/>
                    <local:PerspectiveEditor x:Name="UpdatePerspective" HorizontalAlignment="Left"/>
                    <Button Content="Update" Width="120" HorizontalAlignment="Left" Margin="0,8" Click="UpdateClick"/>
                </StackPanel></ScrollViewer>
            </TabItem>
            <TabItem Header="UpdateTile">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="8">
                    <TextBlock Text="Tile file (decoded as BGRA32)"/><DockPanel><TextBox x:Name="TileFile"/><Button Content="Browse" DockPanel.Dock="Right" Width="90" Click="BrowseTileClick"/></DockPanel>
                    <WrapPanel Margin="0,6"><TextBlock Text="Layer"/><TextBox x:Name="TileLayer" Width="55" Text="0" Margin="4,0,12,0"/><TextBlock Text="Row"/><TextBox x:Name="TileRow" Width="60" Text="0" Margin="4,0,12,0"/><TextBlock Text="Column"/><TextBox x:Name="TileColumn" Width="60" Text="0" Margin="4,0,12,0"/><TextBlock Text="Storage"/><TextBlock x:Name="TileStorageInfo" Text="Create or open an image first." Margin="4,0,0,0"/></WrapPanel>
                    <TextBlock x:Name="TileFileInfo" Text="Choose an image file. Tile size, stride and format are automatic." Margin="0,6,0,2"/>
                    <TextBlock Text="For Yuv422/Yuv420, select the raw Y and UV plane files below. Their dimensions and strides come from the image format and tile layout." Margin="0,6,0,2" TextWrapping="Wrap"/>
                    <TextBlock Text="Y plane file"/><DockPanel><TextBox x:Name="YPlaneFile"/><Button Content="Browse" DockPanel.Dock="Right" Width="90" Click="BrowseYPlaneClick"/></DockPanel>
                    <TextBlock Text="UV plane file"/><DockPanel><TextBox x:Name="UvPlaneFile"/><Button Content="Browse" DockPanel.Dock="Right" Width="90" Click="BrowseUvPlaneClick"/></DockPanel>
                    <TextBlock x:Name="YuvPlaneInfo" Margin="0,4,0,0"/>
                    <Button Content="UpdateTile" Width="120" HorizontalAlignment="Left" Margin="0,8" Click="UpdateTileClick"/>
                </StackPanel></ScrollViewer>
            </TabItem>
            <TabItem Header="Load / Export">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="8">
                    <WrapPanel><TextBlock Text="Mode" VerticalAlignment="Center"/><ComboBox x:Name="LoadMode" Width="150" Margin="5,0,15,0"><ComboBoxItem Content="Layer" IsSelected="True"/><ComboBoxItem Content="Compose"/></ComboBox><TextBlock Text="Layer" VerticalAlignment="Center"/><TextBox x:Name="LoadLayer" Width="55" Text="0" Margin="5,0,15,0"/><TextBlock Text="Format" VerticalAlignment="Center"/><ComboBox x:Name="LoadFormat" Width="120"/></WrapPanel>
                    <TextBlock Text="Compose expression (for Compose mode)" Margin="0,8,0,2"/><TextBox x:Name="ComposeExpression" Text="a.r, a.g, a.b, 1"/>
                    <WrapPanel Margin="0,8"><TextBlock Text="Output width"/><TextBox x:Name="LoadWidth" Width="70" Text="1024" Margin="5,0,15,0"/><TextBlock Text="Height"/><TextBox x:Name="LoadHeight" Width="70" Text="768" Margin="5,0,15,0"/><TextBlock Text="Stride"/><TextBox x:Name="LoadStride" Width="90" Text="0"/></WrapPanel>
                    <TextBlock Text="Drag the target quadrilateral. Its coordinate system is the output image." Margin="0,8,0,4"/>
                    <local:PerspectiveEditor x:Name="LoadPerspective" HorizontalAlignment="Left"/>
                    <TextBlock Text="Export file" Margin="0,8,0,2"/><DockPanel><TextBox x:Name="ExportFile"/><Button Content="Browse" DockPanel.Dock="Right" Width="90" Click="BrowseExportClick"/></DockPanel>
                    <Button Content="Load and export" Width="140" HorizontalAlignment="Left" Margin="0,8" Click="LoadExportClick"/>
                </StackPanel></ScrollViewer>
            </TabItem>
            <TabItem Header="Preview">
                <Grid Margin="8">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <WrapPanel Margin="0,0,0,8"><TextBlock Text="Layer" VerticalAlignment="Center"/><ComboBox x:Name="PreviewLayer" Width="180" Margin="6,0,12,0"/><Button Content="Render" Width="100" Click="RenderPreviewClick"/></WrapPanel>
                    <Border x:Name="PreviewHost" Grid.Row="1" BorderBrush="Gray" BorderThickness="1" Background="Black" MinHeight="200">
                        <Image x:Name="PreviewImage" HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="None"/>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem Header="Persistence">
                <StackPanel Margin="8"><TextBlock Text="Binary serialization uses a versioned GrotheImage header and loader registry." Margin="0,0,0,8"/><Button Content="Save GrotheImage" Width="150" HorizontalAlignment="Left" Click="SaveImageClick"/><Button Content="Open GrotheImage" Width="150" HorizontalAlignment="Left" Margin="0,8" Click="OpenImageClick"/></StackPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
