<UserControl x:Class="GrotheImagesPlayground.PerspectiveEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="360" MinHeight="250">
    <Border BorderBrush="Gray" BorderThickness="1" Background="White">
        <Canvas x:Name="Surface" Width="420" Height="260" ClipToBounds="True">
            <Polygon x:Name="Polygon" Stroke="DarkBlue" StrokeThickness="1" Fill="#22000080" />
            <Line x:Name="TopLine" Stroke="DarkBlue" StrokeThickness="1" />
            <Line x:Name="RightLine" Stroke="DarkBlue" StrokeThickness="1" />
            <Line x:Name="BottomLine" Stroke="DarkBlue" StrokeThickness="1" />
            <Line x:Name="LeftLine" Stroke="DarkBlue" StrokeThickness="1" />
            <Ellipse x:Name="Point0" Width="14" Height="14" Fill="Red" Stroke="Black" MouseLeftButtonDown="PointMouseDown" MouseMove="PointMouseMove" MouseLeftButtonUp="PointMouseUp" />
            <Ellipse x:Name="Point1" Width="14" Height="14" Fill="Red" Stroke="Black" MouseLeftButtonDown="PointMouseDown" MouseMove="PointMouseMove" MouseLeftButtonUp="PointMouseUp" />
            <Ellipse x:Name="Point2" Width="14" Height="14" Fill="Red" Stroke="Black" MouseLeftButtonDown="PointMouseDown" MouseMove="PointMouseMove" MouseLeftButtonUp="PointMouseUp" />
            <Ellipse x:Name="Point3" Width="14" Height="14" Fill="Red" Stroke="Black" MouseLeftButtonDown="PointMouseDown" MouseMove="PointMouseMove" MouseLeftButtonUp="PointMouseUp" />
        </Canvas>
    </Border>
</UserControl>
